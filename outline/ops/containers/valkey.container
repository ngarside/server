[Container]
AddCapability=CAP_CHOWN
AddCapability=CAP_SETGID
AddCapability=CAP_SETUID
ContainerName=outline_valkey
DropCapability=all
Image=ghcr.io/ngarside/valkey:9.1.1.1300@sha256:b08cf7d57514c1e6c5b2e609c5c468da55035eba4b52e0fd2b05c38541a89933
Memory=4g
Network=outline_internal.network:ip=10.19.0.4
NoNewPrivileges=true
ReadOnly=true
UserNS=auto

[Service]
CPUQuota=100%
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
